# Copy to .env and fill in the blanks. .env is never committed.
# Docker Compose, the API, Prisma and the web app all read this one file.

# --- PostgreSQL (docker-compose) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=pg_management
POSTGRES_PORT=5432

# --- Redis (docker-compose) ---
REDIS_PASSWORD=
REDIS_PORT=6379

# --- API ---
NODE_ENV=development
API_PORT=4000
LOG_LEVEL=info
# Origin of the web app, allowed by CORS.
WEB_ORIGIN=http://localhost:3000
# Must repeat the PostgreSQL user, password, port and database from above
# (values are not interpolated), e.g.
# postgresql://postgres:<POSTGRES_PASSWORD>@localhost:5432/pg_management?schema=public
DATABASE_URL=
# Not read by the API yet. Format: redis://:<REDIS_PASSWORD>@localhost:6379
REDIS_URL=

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:4000
